# 开发环境默认使用 Docker Compose 中的 PostgreSQL。
DATABASE_URL=postgresql+psycopg://vibe_market:vibe_market_dev@db:5432/vibe_market

# 允许访问 API 的前端地址；部署时改成你的正式域名。
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://laizao-next-experience.otis-long2002.chatgpt.site

# mock：无需 Key，也能演示 AI 摘要；deepseek：使用 DeepSeek API。
AI_PROVIDER=mock
AUTH_SECRET=change-this-before-production
AUTH_TOKEN_TTL_SECONDS=604800
SMS_MODE=local
LOCAL_SMS_CODE=123456
ADMIN_PHONE=13900000000
UPLOAD_DIR=/app/uploads
PUBLIC_API_BASE_URL=http://localhost:8001
MAX_UPLOAD_BYTES=104857600
MAX_COVER_BYTES=5242880
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
